#!/system/bin/sh
# ============================================================
# Sub-Store for Android 模块配置
# 本文件只包含模块特有的配置 (路径 / 运行用户等)
# 服务相关环境变量 (端口/推送/代理等) 请编辑同目录下的 sub_store.env
#
# 修改后重启服务生效:
#   su -c "sh /data/adb/modules/sub_store/scripts/sub_store.service restart"
# ============================================================

# ---------- 路径 (一般不需要修改) ----------
# 数据目录: /data/local 是 shell 域默认可访问的路径 (shell_data_file 标签),
# 低权限用户 (uid 2000) 无需额外 SELinux 规则即可访问, 也不会暴露 root
sub_store_path="/data/local/sub_store"
bin_name="sub_store_node"
script_name="sub-store.bundle.js"
http_meta_script_name="http-meta.bundle.js"
bin_path="${sub_store_path}/bin/${bin_name}"
script_path="${sub_store_path}/bin/${script_name}"
http_meta_script_path="${sub_store_path}/bin/${http_meta_script_name}"
run_path="${sub_store_path}/run"
pid_file="${run_path}/${bin_name}.pid"
http_meta_pid_file="${run_path}/http-meta.pid"

# ---------- 运行用户 ----------
# node 默认以低权限 shell (uid 2000) 运行, 不授予多余权限
# 运行目录 (run/) 与 http-meta 目录已由安装脚本自动授权给该用户
# 置空则以 root 运行
run_as_user="shell"

# ---------- http-meta 运行选项 ----------
# ！仅 shell 用户
# 给 http-meta 进程额外授予 inet 组权限, 以便在 Android 上使用系统 DNS (getaddrinfo)
# 但会导致 http-meta 进程流量经过 VPN，默认关闭
run_http_meta_with_inet="false"
