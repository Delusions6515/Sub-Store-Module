#!/system/bin/sh
# ============================================================
# Sub-Store for Android 配置文件
#
# 修改后重启服务生效:
#   su -c "sh /data/adb/modules/sub_store/scripts/sub_store.service restart"
#
# 各变量对应 Docker 版环境变量, 完整说明参考:
#   https://hub.docker.com/r/xream/sub-store
# ============================================================

# ---------- 路径 (一般不需要修改) ----------
sub_store_path="/data/adb/sub_store"
bin_name="sub_store_node"
script_name="sub-store.bundle.js"
http_meta_script_name="http-meta.bundle.js"
bin_path="${sub_store_path}/bin/${bin_name}"
script_path="${sub_store_path}/bin/${script_name}"
http_meta_script_path="${sub_store_path}/bin/${http_meta_script_name}"
run_path="${sub_store_path}/run"
pid_file="${run_path}/${bin_name}.pid"
http_meta_pid_file="${run_path}/http-meta.pid"

# ---------- 推送服务 (SUB_STORE_PUSH_SERVICE) ----------
# 支持 Bark / Telegram Bot / PushPlus / shoutrrr, 示例见 Docker 说明
sub_store_backend_push_service=""

# ---------- MaxMind GeoLite2 数据库 (SUB_STORE_MMDB_*) ----------
# 搭配测活脚本使用, 数据来自本地可节约请求时间
sub_store_mmdb_country_path=""
sub_store_mmdb_asn_path=""

# ---------- 后端监听 (SUB_STORE_BACKEND_API_HOST / SUB_STORE_BACKEND_API_PORT) ----------
# 需要局域网访问时把 127.0.0.1 改为 0.0.0.0
sub_store_backend_host="127.0.0.1"
sub_store_backend_port="3000"
sub_store_backend_data_path="${sub_store_path}/run"

# 请求 Body 限制 (SUB_STORE_BODY_JSON_LIMIT), 报 request entity too large 时调大
sub_store_body_json_limit="1mb"

# ---------- 前后端合并 (SUB_STORE_BACKEND_MERGE / SUB_STORE_FRONTEND_BACKEND_PATH) ----------
# 开启后只有一个端口, 例如 http://127.0.0.1:3000?api=http://127.0.0.1:3000/2cXaAxRGfddmGz2yx1wA
# sub_store_backend_merge="true"
# sub_store_frontend_backend_path="/2cXaAxRGfddmGz2yx1wA"

# ---------- 前端监听 (SUB_STORE_FRONTEND_HOST / SUB_STORE_FRONTEND_PORT / SUB_STORE_FRONTEND_PATH) ----------
sub_store_frontend_host="${sub_store_backend_host}"
sub_store_frontend_port="3001"
sub_store_frontend_path="${sub_store_path}/bin/frontend"

# ---------- 其它后端环境变量 (可选) ----------
# 订阅响应头过大时报 Headers Overflow Error 时调大 (SUB_STORE_MAX_HEADER_SIZE)
# sub_store_max_header_size="65536"
# CORS 白名单, 默认 * (SUB_STORE_CORS_ALLOWED_ORIGINS)
# sub_store_cors_allowed_origins="*"
# 默认代理, 支持 SOCKS5/HTTP/HTTPS (SUB_STORE_BACKEND_DEFAULT_PROXY)
# sub_store_backend_default_proxy="socks5://127.0.0.1:7890"
# 前端显示的运行环境名称/图标 (SUB_STORE_BACKEND_CUSTOM_NAME / SUB_STORE_BACKEND_CUSTOM_ICON)
# sub_store_backend_custom_name=""
# sub_store_backend_custom_icon=""
# 自定义响应头 X-Powered-By (SUB_STORE_X_POWERED_BY)
# sub_store_x_powered_by=""

# ---------- HTTP-META (HOST / PORT / BODY_JSON_LIMIT / META_FOLDER / META_TEMP_FOLDER) ----------
# 与后端同 host, 一般不需要改
http_meta_host="${sub_store_backend_host}"
# HTTP-META 端口, 9876 可能与其他服务冲突, 可自行调整
http_meta_port="9876"
http_meta_meta_path="${sub_store_path}/bin/http-meta"
http_meta_body_json_limit="${sub_store_body_json_limit}"
# 调试: 保留每次运行的核心日志和配置 (META_DISABLE_AUTO_CLEAN)
# http_meta_disable_auto_clean="true"
