#!/system/bin/sh
# ============================================================
# Sub-Store / HTTP-META 服务控制
# 用法: sub_store.service {start|stop|restart}
# 供开机启动脚本 / action.sh / 手动执行调用
# ============================================================

SCRIPTS_DIR=$(dirname "$0")
. "$SCRIPTS_DIR/lib.sh"
SERVICE_STARTING=1   # 启动流程不触发配置修改提醒 (本次启动即应用新配置)
load_config

export PATH="/data/adb/magisk:/data/adb/ksu/bin:/data/adb/ap/bin:$PATH"

mkdir -p "$run_path"

# 清理 3 天前的旧日志
find "$sub_store_path" -mtime +3 -type f -name "*.log" -delete 2>/dev/null

log() {
  export TZ=Asia/Shanghai
  now=$(date +"[%Y-%m-%d %H:%M:%S %Z]")
  case $1 in
    Info)  [ -t 1 ] && echo -e "\033[1;32m${now} [Info]: $2\033[0m" || echo "${now} [Info]: $2" ;;
    Warn)  [ -t 1 ] && echo -e "\033[1;33m${now} [Warn]: $2\033[0m" || echo "${now} [Warn]: $2" ;;
    Error) [ -t 1 ] && echo -e "\033[1;31m${now} [Error]: $2\033[0m" || echo "${now} [Error]: $2" ;;
    *)     [ -t 1 ] && echo -e "\033[1;30m${now} [$1]: $2\033[0m" || echo "${now} [$1]: $2" ;;
  esac
}

is_pid_running() {
  local pid_file="$1"
  local match="$2"
  local pid

  [ -f "$pid_file" ] || return 1

  pid=$(cat "$pid_file" 2>/dev/null)
  case "$pid" in
    ''|*[!0-9]*)
      rm -f "$pid_file"
      return 1
      ;;
  esac

  if ! kill -0 "$pid" 2>/dev/null; then
    rm -f "$pid_file"
    return 1
  fi

  # 防止 PID 已被其他进程复用
  if ! tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null |
       grep -F "$match" >/dev/null; then
    rm -f "$pid_file"
    return 1
  fi

  return 0
}

stop_by_pidfile() {
  local pid_file="$1"
  local name="$2"
  local match="$3"
  local pid i

  if ! is_pid_running "$pid_file" "$match"; then
    rm -f "$pid_file"
    return 0
  fi

  pid=$(cat "$pid_file")

  log Warn "stopping $name service (PID $pid)."
  kill -15 "$pid" 2>/dev/null

  i=0
  while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 20 ]; do
    sleep 0.1
    i=$((i + 1))
  done

  if kill -0 "$pid" 2>/dev/null; then
    log Warn "$name 未在超时时间内退出, 强制结束 PID $pid"
    kill -9 "$pid" 2>/dev/null
  fi

  rm -f "$pid_file"
}

# ---------- http-meta VPN 绕过 ----------
# Android fwmark 的 0x20000 为 protectedFromVpn。http-meta 使用独立主 GID，
# 仅匹配该进程的本地出站流量，不影响同为 uid 2000 的 Sub-Store / adb shell。
HTTP_META_BYPASS_GID=9999
HTTP_META_BYPASS_MARK="0x20000/0x20000"
HTTP_META_BYPASS_CHAIN="SUBSTORE_HTTPMETA"

http_meta_bypass_vpn_enabled() {
  [ "${run_http_meta:-true}" = "true" ] || return 1
  [ "${run_http_meta_bypass_vpn:-true}" = "true" ] || return 1
  [ "${run_as_user:-root}" = "shell" ] || [ "${run_as_user:-root}" = "2000" ]
}

http_meta_bypass_vpn_rule() {
  local ipt="$1"
  local action="$2"
  local extra_mark="${http_meta_bypass_vpn_extra_mark:-}"

  command -v "$ipt" >/dev/null 2>&1 || return 1

  case "$action" in
    add)
      # 清理旧版直接挂在 OUTPUT 上的规则
      while "$ipt" -t mangle -C OUTPUT \
        -m owner --uid-owner 2000 --gid-owner "$HTTP_META_BYPASS_GID" \
        -j MARK --set-xmark "$HTTP_META_BYPASS_MARK" >/dev/null 2>&1; do
        "$ipt" -t mangle -D OUTPUT \
          -m owner --uid-owner 2000 --gid-owner "$HTTP_META_BYPASS_GID" \
          -j MARK --set-xmark "$HTTP_META_BYPASS_MARK" >/dev/null 2>&1 || break
      done

      "$ipt" -t mangle -N "$HTTP_META_BYPASS_CHAIN" 2>/dev/null || true
      "$ipt" -t mangle -F "$HTTP_META_BYPASS_CHAIN" || return 1
      "$ipt" -t mangle -A "$HTTP_META_BYPASS_CHAIN" \
        -j MARK --set-xmark "$HTTP_META_BYPASS_MARK" || return 1

      if [ -n "$extra_mark" ]; then
        "$ipt" -t mangle -A "$HTTP_META_BYPASS_CHAIN" \
          -j MARK --set-xmark "$extra_mark" || return 1
      fi

      "$ipt" -t mangle -C OUTPUT \
        -m owner --uid-owner 2000 --gid-owner "$HTTP_META_BYPASS_GID" \
        -j "$HTTP_META_BYPASS_CHAIN" >/dev/null 2>&1 ||
        "$ipt" -t mangle -I OUTPUT 1 \
          -m owner --uid-owner 2000 --gid-owner "$HTTP_META_BYPASS_GID" \
          -j "$HTTP_META_BYPASS_CHAIN"
      ;;
    del)
      while "$ipt" -t mangle -C OUTPUT \
        -m owner --uid-owner 2000 --gid-owner "$HTTP_META_BYPASS_GID" \
        -j "$HTTP_META_BYPASS_CHAIN" >/dev/null 2>&1; do
        "$ipt" -t mangle -D OUTPUT \
          -m owner --uid-owner 2000 --gid-owner "$HTTP_META_BYPASS_GID" \
          -j "$HTTP_META_BYPASS_CHAIN" >/dev/null 2>&1 || break
      done

      # 兼容清理旧版直接挂在 OUTPUT 上的 protectedFromVpn 规则
      while "$ipt" -t mangle -C OUTPUT \
        -m owner --uid-owner 2000 --gid-owner "$HTTP_META_BYPASS_GID" \
        -j MARK --set-xmark "$HTTP_META_BYPASS_MARK" >/dev/null 2>&1; do
        "$ipt" -t mangle -D OUTPUT \
          -m owner --uid-owner 2000 --gid-owner "$HTTP_META_BYPASS_GID" \
          -j MARK --set-xmark "$HTTP_META_BYPASS_MARK" >/dev/null 2>&1 || break
      done

      "$ipt" -t mangle -F "$HTTP_META_BYPASS_CHAIN" >/dev/null 2>&1 || true
      "$ipt" -t mangle -X "$HTTP_META_BYPASS_CHAIN" >/dev/null 2>&1 || true
      ;;
    *)
      return 1
      ;;
  esac
}

setup_http_meta_bypass_vpn() {
  local failed=0

  if ! http_meta_bypass_vpn_enabled; then
    cleanup_http_meta_bypass_vpn
    return 0
  fi

  if ! http_meta_bypass_vpn_rule iptables add; then
    log Error "无法添加 http-meta IPv4 VPN 绕过规则"
    failed=1
  fi

  if command -v ip6tables >/dev/null 2>&1; then
    if ! http_meta_bypass_vpn_rule ip6tables add; then
      log Error "无法添加 http-meta IPv6 VPN 绕过规则"
      failed=1
    fi
  else
    log Warn "未找到 ip6tables, 跳过 http-meta IPv6 VPN 绕过规则"
  fi

  [ "$failed" = "0" ] || {
    cleanup_http_meta_bypass_vpn
    return 1
  }

  if [ -n "${http_meta_bypass_vpn_extra_mark:-}" ]; then
    log Info "http-meta VPN 绕过已启用 (gid $HTTP_META_BYPASS_GID, protectedFromVpn + ${http_meta_bypass_vpn_extra_mark})"
  else
    log Info "http-meta VPN 绕过已启用 (gid $HTTP_META_BYPASS_GID, protectedFromVpn)"
  fi
  return 0
}

cleanup_http_meta_bypass_vpn() {
  http_meta_bypass_vpn_rule iptables del >/dev/null 2>&1 || true
  http_meta_bypass_vpn_rule ip6tables del >/dev/null 2>&1 || true
}

start_bin() {
  log Info "starting ${bin_name} service."
  ulimit -SHn 1000000
  chmod 755 "$bin_path" "$http_meta_meta_path/http-meta" 2>/dev/null
  # 更新脚本下载的文件可能因 umask 是 600 root, 低权限用户 (shell) 需可读
  chmod 644 "$script_path" "$http_meta_script_path" "$http_meta_meta_path/tpl.yaml" "$SCRIPTS_DIR/drop_priv.js" "$SCRIPTS_DIR/node_daemon.js" 2>/dev/null
  chmod -R a+rX "$sub_store_path/bin/frontend" "$http_meta_meta_path" 2>/dev/null

  # 低权限运行: 默认以 shell(uid 2000) 运行 node, 不授予多余权限
  # 数据目录在 /data/local/sub_store (shell 域原生可访问), 无需额外 SELinux 规则
  # shell 用户可选 su（启动前切换用户）或 node（Node preload 自降权）
  # 3003(inet 组) https://android.googlesource.com/platform/system/core/+/refs/heads/main/libcutils/include/private/android_filesystem_config.h#167
  # http-meta 的 inet 组仅控制 Android 系统 DNS 权限; VPN 绕过由 run_http_meta_bypass_vpn 控制
  local drop_preload="" drop_env="" meta_drop_env="" root_su="" shell_su="" meta_shell_su="" node_su="" method="" meta_gid=2000
  case "${run_as_user:-root}" in
    shell|2000)
      if [ "${run_http_meta_bypass_vpn:-true}" = "true" ]; then
        meta_gid="$HTTP_META_BYPASS_GID"
      fi

      method=${drop_priv_method:-}
      if [ -z "$method" ]; then
        if [ -d /data/adb/ksu ] || [ -d /data/adb/ap ]; then
          method="su"
        else
          method="node"
        fi
        log Warn "未设置 drop_priv_method, 自动使用 $method"
      fi
      case "$method" in
        su)
          if ! su 2000 -g 2000 -G 3003 -c id >/dev/null 2>&1; then
            log Error "降权方式 su 不支持 -g/-G"
            return 1
          fi
          shell_su="su 2000 -g 2000 -G 3003 -c"
          log Info "降权方式: su (Sub-Store: uid 2000 + inet 组 3003)"
          if [ "${run_http_meta}" = "true" ]; then
            if [ "${run_http_meta_with_inet:-false}" = "true" ]; then
              meta_shell_su="su 2000 -g $meta_gid -G 3003 -c"
              log Info "降权方式: su (http-meta: uid 2000 + gid $meta_gid + inet 组 3003)"
            else
              meta_shell_su="su 2000 -g $meta_gid -c"
              log Info "降权方式: su (http-meta: uid 2000 + gid $meta_gid)"
            fi
          fi
          ;;
        node)
          drop_preload="$SCRIPTS_DIR/drop_priv.js"
          drop_env="DROP_UID=2000 DROP_GID=2000 DROP_GROUPS=3003"
          if [ -d /data/adb/ksu ] || [ -d /data/adb/ap ]; then
            node_su="su 0 -c"
            log Info "降权方式: node (KSU/APatch 经 su 0 启动)"
          fi
          log Info "降权方式: node (Sub-Store: uid 2000 + inet 组 3003)"
          if [ "${run_http_meta_with_inet:-false}" = "true" ]; then
            meta_drop_env="DROP_UID=2000 DROP_GID=$meta_gid DROP_GROUPS=3003"
            log Info "降权方式: node (http-meta: uid 2000 + gid $meta_gid + inet 组 3003)"
          else
            meta_drop_env="DROP_UID=2000 DROP_GID=$meta_gid DROP_GROUPS="
            log Info "降权方式: node (http-meta: uid 2000 + gid $meta_gid)"
          fi
          ;;
        *)
          log Error "未知 drop_priv_method: $method (可选 su|node)"
          return 1
          ;;
      esac
      ;;
    root)
      if [ -d /data/adb/ksu ] || [ -d /data/adb/ap ]; then
        root_su="su 0 -c"
        log Info "以 root 运行 (su 0)"
      else
        root_su="su -c"
        log Info "以 root 运行"
      fi
      ;;
    *)
      if [ -d /data/adb/ksu ] || [ -d /data/adb/ap ]; then
        root_su="su 0 -c"
        log Warn "未知 run_as_user: ${run_as_user:-root}, 回退以 root 运行 (su 0)"
      else
        log Warn "未知 run_as_user: ${run_as_user:-root}, 回退以 root 运行"
      fi
      ;;
  esac

  # 运行前重新授权: 更新脚本以 root 写入后, 低权限用户目录所有权可能漂移
  if [ "${run_as_user:-}" = "shell" ] || [ "${run_as_user:-}" = "2000" ]; then
    chown -R 2000:2000 "$run_path" "$http_meta_meta_path" 2>/dev/null || true
  fi

  # 配置 http-meta 的 Android VPN 绕过规则
  if ! setup_http_meta_bypass_vpn; then
    return 1
  fi

  # 导入 sub_store.env 中定义的全部环境变量 (对应 Docker 版, 新增变量无需改脚本)
  if [ -n "${ENV_SOURCE:-}" ] && [ -f "$ENV_SOURCE" ]; then
    while IFS='=' read -r _env_k _env_v; do
      case "$_env_k" in
        \#*|"") continue ;;                       # 注释/空行
        [A-Za-z_]*[A-Za-z0-9_]*)
          # 布尔归一 (后端 truthy 判断): SUB_STORE_BACKEND_MERGE 非 "true" 不导出
          # (变量留在 shell 但 node 看不到, 与 xream 模块 true-only 行为一致,
          #  设 false/其它值 = 关闭合并, 不会被后端的非空即合并误判)
          if [ "$_env_k" = "SUB_STORE_BACKEND_MERGE" ]; then
            _env_v=$(printf '%s' "$_env_v" | tr -d '"')
            [ "$_env_v" = "true" ] || continue
          fi
          export "$_env_k" ;;
      esac
    done < "$ENV_SOURCE"
  fi

  # su 方式 在启动前切换到 shell 用户
  # root 经 su 0 重开执行环境，避免直接继承 WebUI root shell。
  if [ -n "$shell_su" ]; then
    if is_pid_running "$pid_file" "$script_path"; then
      log Warn "Sub-Store 已在运行 (PID $(cat "$pid_file")), 跳过启动"
    else
      rotate_sub_store_log
      $shell_su "nohup '$bin_path' '$script_path' >'$run_path/${bin_name}.log' 2>'$run_path/${bin_name}_error.log' & echo \$! > '$pid_file'"
    fi
    if [ "${run_http_meta:-true}" = "true" ]; then
      if is_pid_running "$http_meta_pid_file" "$http_meta_script_path"; then
        log Warn "http-meta 已在运行 (PID $(cat "$http_meta_pid_file")), 跳过启动"
      else
        rotate_http_meta_log
        $meta_shell_su "nohup '$bin_path' '$http_meta_script_path' >'$run_path/http-meta.log' 2>'$run_path/http-meta_error.log' & echo \$! > '$http_meta_pid_file'"
      fi
    fi
  # node 方式 运行时自降权
  # 启动 daemon 创建独立 session，再派生加载降权 preload 的业务 Node 进程。
  elif [ -n "$drop_preload" ]; then
    local daemon="$SCRIPTS_DIR/node_daemon.js"
    local node_start_failed=0
    if [ ! -f "$drop_preload" ]; then
      log Error "缺少 node drop_priv: $drop_preload, 您可能需要重新安装模块以解决问题."
      return 1
    fi
    if [ ! -f "$daemon" ]; then
      log Error "缺少 node daemon: $daemon, 您可能需要重新安装模块以解决问题."
      return 1
    fi
    if [ -n "$node_su" ]; then
      if is_pid_running "$pid_file" "$script_path"; then
        log Warn "Sub-Store 已在运行 (PID $(cat "$pid_file")), 跳过启动"
      else
        rotate_sub_store_log
        if ! $node_su "env $drop_env '$bin_path' '$daemon' '$bin_path' '${drop_preload}' '$script_path' '$run_path/${bin_name}.log' '$run_path/${bin_name}_error.log' '$pid_file'"; then
          log Error "Sub-Store 启动失败 (node daemon 退出码非 0, 原因见上方 stderr)"
          node_start_failed=1
        fi
      fi
      if [ "${run_http_meta:-true}" = "true" ]; then
        if is_pid_running "$http_meta_pid_file" "$http_meta_script_path"; then
          log Warn "http-meta 已在运行 (PID $(cat "$http_meta_pid_file")), 跳过启动"
        else
          rotate_http_meta_log
          if ! $node_su "env $meta_drop_env '$bin_path' '$daemon' '$bin_path' '${drop_preload}' '$http_meta_script_path' '$run_path/http-meta.log' '$run_path/http-meta_error.log' '$http_meta_pid_file'"; then
            log Error "http-meta 启动失败 (node daemon 退出码非 0, 原因见上方 stderr)"
            node_start_failed=1
          fi
        fi
      fi
    else
      if is_pid_running "$pid_file" "$script_path"; then
        log Warn "Sub-Store 已在运行 (PID $(cat "$pid_file")), 跳过启动"
      else
        rotate_sub_store_log
        if ! env $drop_env "$bin_path" "$daemon" "$bin_path" "${drop_preload}" "$script_path" "$run_path/${bin_name}.log" "$run_path/${bin_name}_error.log" "$pid_file"; then
          log Error "Sub-Store 启动失败 (node daemon 退出码非 0, 原因见上方 stderr)"
          node_start_failed=1
        fi
      fi
      if [ "${run_http_meta:-true}" = "true" ]; then
        if is_pid_running "$http_meta_pid_file" "$http_meta_script_path"; then
          log Warn "http-meta 已在运行 (PID $(cat "$http_meta_pid_file")), 跳过启动"
        else
          rotate_http_meta_log
          if ! env $meta_drop_env "$bin_path" "$daemon" "$bin_path" "${drop_preload}" "$http_meta_script_path" "$run_path/http-meta.log" "$run_path/http-meta_error.log" "$http_meta_pid_file"; then
            log Error "http-meta 启动失败 (node daemon 退出码非 0, 原因见上方 stderr)"
            node_start_failed=1
          fi
        fi
      fi
    fi

    [ "$node_start_failed" = "1" ] && return 1
  else
    if is_pid_running "$pid_file" "$script_path"; then
      log Warn "Sub-Store 已在运行 (PID $(cat "$pid_file")), 跳过启动"
    else
      rotate_sub_store_log
      $root_su "nohup '$bin_path' '$script_path' >'$run_path/${bin_name}.log' 2>'$run_path/${bin_name}_error.log' & echo \$! > '$pid_file'"
    fi
    if [ "${run_http_meta:-true}" = "true" ]; then
      if is_pid_running "$http_meta_pid_file" "$http_meta_script_path"; then
        log Warn "http-meta 已在运行 (PID $(cat "$http_meta_pid_file")), 跳过启动"
      else
        rotate_http_meta_log
        $root_su "nohup '$bin_path' '$http_meta_script_path' >'$run_path/http-meta.log' 2>'$run_path/http-meta_error.log' & echo \$! > '$http_meta_pid_file'"
      fi
    fi
  fi

  # 记录本次启动时间 (写入内容 + 更新 mtime), 用于配置修改提醒
  date '+%Y-%m-%d %H:%M:%S' > "$run_path/.start_marker" 2>/dev/null

  return 0
}

stop_service() {
  stop_by_pidfile "$http_meta_pid_file" "http-meta" "$http_meta_script_path"
  stop_by_pidfile "$pid_file" "Sub-Store" "$script_path"
  # 等待 node 退出并让 http-meta 清理 mihomo 子进程
  sleep 2
  # 兜底: 结束残留的 mihomo 内核
  _pids=$(pidof http-meta 2>/dev/null)
  [ -n "$_pids" ] && kill -15 $_pids 2>/dev/null
  cleanup_http_meta_bypass_vpn
  return 0
}

case "$1" in
  start)
    start_bin
    ;;
  stop)
    stop_service
    ;;
  restart)
    stop_service
    sleep 2
    start_bin
    ;;
  *)
    log Error "用法: $0 {start|stop|restart}"
    exit 1
    ;;
esac
