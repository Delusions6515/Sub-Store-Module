#!/system/bin/sh
# ============================================================
# Sub-Store / HTTP-META 服务控制
# 用法: sub_store.service {start|stop|restart}
# 供开机启动脚本 / action.sh / 手动执行调用
# ============================================================

SCRIPTS_DIR=$(dirname "$0")
. "$SCRIPTS_DIR/lib.sh"
SERVICE_STARTING=1   # 启动流程不触发配置修改提醒 (本次启动即应用新配置)
load_config

export PATH="/data/adb/magisk:/data/adb/ksu/bin:/data/adb/ap/bin:$PATH"

mkdir -p "$run_path"

# 清理 3 天前的旧日志
find "$sub_store_path" -mtime +3 -type f -name "*.log" -delete 2>/dev/null

log() {
  export TZ=Asia/Shanghai
  now=$(date +"[%Y-%m-%d %H:%M:%S %Z]")
  case $1 in
    Info)  [ -t 1 ] && echo -e "\033[1;32m${now} [Info]: $2\033[0m" || echo "${now} [Info]: $2" ;;
    Warn)  [ -t 1 ] && echo -e "\033[1;33m${now} [Warn]: $2\033[0m" || echo "${now} [Warn]: $2" ;;
    Error) [ -t 1 ] && echo -e "\033[1;31m${now} [Error]: $2\033[0m" || echo "${now} [Error]: $2" ;;
    *)     [ -t 1 ] && echo -e "\033[1;30m${now} [$1]: $2\033[0m" || echo "${now} [$1]: $2" ;;
  esac
}

start_bin() {
  if pidof "$bin_name" >/dev/null 2>&1; then
    log Warn "${bin_name} 已在运行, 跳过启动"
    return 0
  fi

  log Info "starting ${bin_name} service."
  ulimit -SHn 1000000
  chmod 755 "$bin_path" "$http_meta_meta_path/http-meta" 2>/dev/null
  # 更新脚本下载的文件可能因 umask 是 600 root, 低权限用户 (shell) 需可读
  chmod 644 "$script_path" "$http_meta_script_path" "$http_meta_meta_path/tpl.yaml" 2>/dev/null
  chmod -R a+rX "$sub_store_path/bin/frontend" "$http_meta_meta_path" 2>/dev/null

  mv "$run_path/${bin_name}.log" "$run_path/${bin_name}.log.bak" >/dev/null 2>&1
  mv "$run_path/${bin_name}_error.log" "$run_path/${bin_name}_error.log.bak" >/dev/null 2>&1
  mv "$run_path/http-meta.log" "$run_path/http-meta.log.bak" >/dev/null 2>&1
  mv "$run_path/http-meta_error.log" "$run_path/http-meta_error.log.bak" >/dev/null 2>&1

  # 低权限运行: 默认以 shell(uid 2000) 运行 node, 不授予多余权限
  # 数据目录在 /data/local/sub_store (shell 域原生可访问), 无需额外 SELinux 规则
  # 降权: 优先系统 toybox setpriv (/system/bin/setpriv, 支持 --reuid, 不受 busybox 影响)
  # 依次尝试带/不带 --init-groups; 再试 su 2000; 最后 root
  local rp="" su_mode=0
  if [ -n "${run_as_user:-}" ]; then
    case "$run_as_user" in
      shell|2000)
        if [ -x /system/bin/setpriv ] \
          && /system/bin/setpriv --reuid 2000 --regid 2000 --init-groups id >/dev/null 2>&1; then
          rp="/system/bin/setpriv --reuid 2000 --regid 2000 --init-groups"
          log Info "降权: /system/bin/setpriv (toybox, --init-groups)"
        elif [ -x /system/bin/setpriv ] \
          && /system/bin/setpriv --reuid 2000 --regid 2000 id >/dev/null 2>&1; then
          rp="/system/bin/setpriv --reuid 2000 --regid 2000"
          log Info "降权: /system/bin/setpriv (toybox)"
        else
          local sp=""
          sp=$(command -v setpriv 2>/dev/null || true)
          if [ -n "$sp" ] \
            && "$sp" --reuid 2000 --regid 2000 --init-groups id >/dev/null 2>&1; then
            rp="$sp --reuid 2000 --regid 2000 --init-groups"
            log Info "降权: $sp (setpriv, --init-groups)"
          elif [ -n "$sp" ] \
            && "$sp" --reuid 2000 --regid 2000 id >/dev/null 2>&1; then
            rp="$sp --reuid 2000 --regid 2000"
            log Info "降权: $sp (setpriv)"
          elif command -v su >/dev/null 2>&1 && su 2000 -c id >/dev/null 2>&1; then
            # su 可用性实测: Magisk/KernelSU/APatch 的 su 都接受 UID 参数,
            # 但 command -v 存在 ≠ 可用, 实测成功才采用 (与 setpriv 同原则)
            su_mode=1
            log Info "降权: su 2000"
          else
            log Warn "setpriv/su 均不可用, 回退以 root 运行"
          fi
        fi
        ;;
      root|"") : ;;
      *) log Warn "未知 run_as_user: $run_as_user, 回退以 root 运行" ;;
    esac
  fi

  # 运行前重新授权: 更新脚本以 root 写入后, 低权限用户目录所有权可能漂移
  if [ "${run_as_user:-}" = "shell" ] || [ "${run_as_user:-}" = "2000" ]; then
    chown -R 2000:2000 "$run_path" "$http_meta_meta_path" 2>/dev/null || true
  fi

  # 导入 sub_store.env 中定义的全部环境变量 (对应 Docker 版, 新增变量无需改脚本)
  if [ -n "${ENV_SOURCE:-}" ] && [ -f "$ENV_SOURCE" ]; then
    while IFS='=' read -r _env_k _env_v; do
      case "$_env_k" in
        \#*|"") continue ;;                       # 注释/空行
        [A-Za-z_]*[A-Za-z0-9_]*)
          # 布尔归一 (后端 truthy 判断): SUB_STORE_BACKEND_MERGE 非 "true" 不导出
          # (变量留在 shell 但 node 看不到, 与 xream 模块 true-only 行为一致,
          #  设 false/其它值 = 关闭合并, 不会被后端的非空即合并误判)
          if [ "$_env_k" = "SUB_STORE_BACKEND_MERGE" ]; then
            _env_v=$(printf '%s' "$_env_v" | tr -d '"')
            [ "$_env_v" = "true" ] || continue
          fi
          export "$_env_k" ;;
      esac
    done < "$ENV_SOURCE"
  fi
  # 启动 (su 模式经 su 2000 -c, 其余直接 nohup)
  if [ "$su_mode" = "1" ]; then
    su 2000 -c "nohup '$bin_path' '$script_path' >'$run_path/${bin_name}.log' 2>'$run_path/${bin_name}_error.log' &"
    su 2000 -c "nohup '$bin_path' '$http_meta_script_path' >'$run_path/http-meta.log' 2>'$run_path/http-meta_error.log' &"
  else
    nohup $rp "$bin_path" "$script_path" >"$run_path/${bin_name}.log" 2>"$run_path/${bin_name}_error.log" &
    nohup $rp "$bin_path" "$http_meta_script_path" >"$run_path/http-meta.log" 2>"$run_path/http-meta_error.log" &
  fi

  # 记录本次启动时间, 用于配置修改提醒
  touch "$run_path/.start_marker" 2>/dev/null

  return 0
}

stop_service() {
  log Warn "stopping ${bin_name} service."
  # 两个进程都由 sub_store_node 运行, 一并结束
  kill -15 $(pidof "$bin_name") 2>/dev/null
  # 等待 node 退出并让 http-meta 清理 mihomo 子进程
  sleep 2
  # 兜底: 结束残留的 mihomo 内核与 node 进程
  kill -15 $(pidof http-meta) 2>/dev/null
  kill -9 $(pidof "$bin_name" http-meta) 2>/dev/null
}

case "$1" in
  start)
    start_bin
    ;;
  stop)
    stop_service
    ;;
  restart)
    stop_service
    sleep 2
    start_bin
    ;;
  *)
    log Error "用法: $0 {start|stop|restart}"
    exit 1
    ;;
esac
