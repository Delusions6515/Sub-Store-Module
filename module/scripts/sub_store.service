#!/system/bin/sh
# ============================================================
# Sub-Store / HTTP-META 服务控制
# 用法: sub_store.service {start|stop|restart}
# 供开机启动脚本 / action.sh / 手动执行调用
# ============================================================

SCRIPTS_DIR=$(dirname "$0")
. "$SCRIPTS_DIR/lib.sh"
load_config

export PATH="/data/adb/magisk:/data/adb/ksu/bin:/data/adb/ap/bin:$PATH"

mkdir -p "$run_path"

# 清理 3 天前的旧日志
find "$sub_store_path" -mtime +3 -type f -name "*.log" -delete 2>/dev/null

log() {
  export TZ=Asia/Shanghai
  now=$(date +"[%Y-%m-%d %H:%M:%S %Z]")
  case $1 in
    Info)  [ -t 1 ] && echo -e "\033[1;32m${now} [Info]: $2\033[0m" || echo "${now} [Info]: $2" ;;
    Warn)  [ -t 1 ] && echo -e "\033[1;33m${now} [Warn]: $2\033[0m" || echo "${now} [Warn]: $2" ;;
    Error) [ -t 1 ] && echo -e "\033[1;31m${now} [Error]: $2\033[0m" || echo "${now} [Error]: $2" ;;
    *)     [ -t 1 ] && echo -e "\033[1;30m${now} [$1]: $2\033[0m" || echo "${now} [$1]: $2" ;;
  esac
}

start_bin() {
  if pidof "$bin_name" >/dev/null 2>&1; then
    log Warn "${bin_name} 已在运行, 跳过启动"
    return 0
  fi

  log Info "starting ${bin_name} service."
  ulimit -SHn 1000000
  chmod 755 "$bin_path" 2>/dev/null

  mv "$run_path/${bin_name}.log" "$run_path/${bin_name}.log.bak" >/dev/null 2>&1
  mv "$run_path/${bin_name}_error.log" "$run_path/${bin_name}_error.log.bak" >/dev/null 2>&1
  mv "$run_path/http-meta.log" "$run_path/http-meta.log.bak" >/dev/null 2>&1
  mv "$run_path/http-meta_error.log" "$run_path/http-meta_error.log.bak" >/dev/null 2>&1

  # 低权限运行: 默认以 shell(uid 2000) 运行 node, 不授予多余权限
  # 需要访问的目录 (run/ 与 http-meta/) 由安装脚本授权给该用户
  local rp=""
  if [ -n "${run_as_user:-}" ]; then
    case "$run_as_user" in
      shell|2000)
        if command -v setpriv >/dev/null 2>&1; then
          rp="setpriv --reuid 2000 --regid 2000 --init-groups"
        else
          log Warn "未找到 setpriv, 回退以 root 运行"
        fi
        ;;
      root|"") : ;;
      *) log Warn "未知 run_as_user: $run_as_user, 回退以 root 运行" ;;
    esac
  fi

  # Sub-Store 后端 (环境变量对应 Docker 版)
  export SUB_STORE_BACKEND_MERGE="$sub_store_backend_merge"
  export SUB_STORE_FRONTEND_BACKEND_PATH="$sub_store_frontend_backend_path"
  export SUB_STORE_BODY_JSON_LIMIT="$sub_store_body_json_limit"
  export SUB_STORE_MMDB_COUNTRY_PATH="$sub_store_mmdb_country_path"
  export SUB_STORE_MMDB_ASN_PATH="$sub_store_mmdb_asn_path"
  export SUB_STORE_FRONTEND_PATH="$sub_store_frontend_path"
  export SUB_STORE_FRONTEND_HOST="$sub_store_frontend_host"
  export SUB_STORE_FRONTEND_PORT="$sub_store_frontend_port"
  export SUB_STORE_DATA_BASE_PATH="$sub_store_backend_data_path"
  export SUB_STORE_PUSH_SERVICE="$sub_store_backend_push_service"
  export SUB_STORE_BACKEND_API_HOST="$sub_store_backend_host"
  export SUB_STORE_BACKEND_API_PORT="$sub_store_backend_port"
  export SUB_STORE_MAX_HEADER_SIZE="$sub_store_max_header_size"
  export SUB_STORE_CORS_ALLOWED_ORIGINS="$sub_store_cors_allowed_origins"
  export SUB_STORE_BACKEND_DEFAULT_PROXY="$sub_store_backend_default_proxy"
  export SUB_STORE_BACKEND_CUSTOM_NAME="$sub_store_backend_custom_name"
  export SUB_STORE_BACKEND_CUSTOM_ICON="$sub_store_backend_custom_icon"
  export SUB_STORE_X_POWERED_BY="$sub_store_x_powered_by"
  nohup $rp "$bin_path" "$script_path" >"$run_path/${bin_name}.log" 2>"$run_path/${bin_name}_error.log" &

  # HTTP-META (环境变量对应 http-meta 的 HOST/PORT/BODY_JSON_LIMIT 等)
  export BODY_JSON_LIMIT="$http_meta_body_json_limit"
  export META_TEMP_FOLDER="$run_path"
  export META_FOLDER="$http_meta_meta_path"
  export HOST="$http_meta_host"
  export PORT="$http_meta_port"
  export META_DISABLE_AUTO_CLEAN="$http_meta_disable_auto_clean"
  nohup $rp "$bin_path" "$http_meta_script_path" >"$run_path/http-meta.log" 2>"$run_path/http-meta_error.log" &

  return 0
}

stop_service() {
  log Warn "stopping ${bin_name} service."
  # 两个进程都由 sub_store_node 运行, 一并结束
  kill -15 $(pidof "$bin_name") 2>/dev/null
  # 等待 node 退出并让 http-meta 清理 mihomo 子进程
  sleep 2
  # 兜底: 结束残留的 mihomo 内核与 node 进程
  kill -15 $(pidof http-meta) 2>/dev/null
  kill -9 $(pidof "$bin_name" http-meta) 2>/dev/null
}

case "$1" in
  start)
    start_bin
    ;;
  stop)
    stop_service
    ;;
  restart)
    stop_service
    sleep 2
    start_bin
    ;;
  *)
    log Error "用法: $0 {start|stop|restart}"
    exit 1
    ;;
esac
